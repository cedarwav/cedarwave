---
import Layout from '../layouts/Layout.astro';

const pillars = [
  {
    title: 'AI Coaching & Literacy',
    text: 'One-on-one coaching for individuals and professionals who want to actually understand and use tools like Claude and GPT — in their work, their business, or their own growth.',
  },
  {
    title: 'AI & Innovation Advisory',
    text: 'For organizations: adoption assessments, training-needs analysis, and group training, all through an innovation lens.',
  },
  {
    title: 'Core Business Consulting',
    text: 'Traditional strategy, operations, and planning support — plus project management for innovation, research, or novel initiatives.',
  },
];
---

<Layout
  title="Cedar Wave Advisory"
  description="Cedar Wave Advisory brings frontier AI experience and solid business fundamentals to small businesses and communities on Vancouver Island — practical, grounded, and never just about the bottom line."
>
  <section class="hero">
    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow">Victoria, BC</p>
      <h1>Cedar Wave Advisory</h1>
      <p class="hero__tagline">Grounded in place. Built for what's next.</p>
      <p class="hero__pitch">
        Cedar Wave Advisory brings frontier AI experience and solid business fundamentals to small
        businesses and communities on Vancouver Island — practical, grounded, and never just about
        the bottom line.
      </p>
      <div class="hero__actions">
        <a href="/contact/" class="btn btn--primary">Book a discovery call</a>
        <a href="/services/" class="btn btn--secondary">See services</a>
      </div>
    </div>
    <svg class="hero__wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#F5F2EA"
        d="M0,32L60,26.7C120,21,240,11,360,16C480,21,600,43,720,48C840,53,960,43,1080,34.7C1200,27,1320,21,1380,18.7L1440,16L1440,60L0,60Z"
      ></path>
    </svg>
  </section>

  <section class="section wrap">
    <p class="eyebrow">What we do</p>
    <h2>Three ways we help</h2>
    <div class="grid-3 pillars">
      {pillars.map((pillar) => (
        <div class="card">
          <h3>{pillar.title}</h3>
          <p>{pillar.text}</p>
        </div>
      ))}
    </div>
    <p class="pillars__more"><a href="/services/">See how each engagement works &rarr;</a></p>
  </section>

  <section class="section section--about">
    <div class="wrap about-teaser">
      <div>
        <p class="eyebrow">About</p>
        <h2>Real experience, not secondhand theory</h2>
        <p>
          Cedar Wave Advisory was built on a simple idea: the tools driving the next decade of
          business shouldn't be locked away in big firms and big cities. We bring frontier AI
          experience — real, hands-on work building agents and automation — together with solid
          business fundamentals, to help small businesses, professionals, and organizations move
          forward with confidence.
        </p>
        <a href="/about/" class="btn btn--outline">Read our story</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta__inner">
      <h2>Let's figure out where AI actually fits.</h2>
      <p>Every engagement starts with a free discovery call — no pressure, no jargon.</p>
      <a href="/contact/" class="btn btn--primary">Get in touch</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: var(--forest);
    color: var(--paper);
    text-align: center;
    padding-top: 5rem;
    position: relative;
    overflow: hidden;
  }

  .hero__eyebrow {
    color: var(--sand);
    letter-spacing: 3px;
  }

  .hero h1 {
    color: var(--paper);
    margin-top: 0.5rem;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .hero__pitch {
    max-width: 640px;
    margin: 0 auto 2rem;
    font-size: 1.05rem;
    color: var(--sand);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    padding-bottom: 3.5rem;
  }

  .hero__wave {
    display: block;
    width: 100%;
    height: 40px;
  }

  .pillars {
    margin-top: 1.75rem;
  }

  .pillars__more {
    margin-top: 1.5rem;
  }

  .pillars__more a {
    text-decoration: none;
    font-weight: 500;
  }

  .section--about {
    background: #fff;
    border-top: 1px solid var(--sand);
    border-bottom: 1px solid var(--sand);
  }

  .about-teaser {
    max-width: 680px;
  }

  .cta {
    background: var(--cedar);
    color: var(--paper);
  }

  .cta__inner {
    text-align: center;
    padding: 3.5rem 1.5rem;
  }

  .cta h2 {
    color: var(--paper);
  }

  .cta p {
    color: var(--sand);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 3.5rem;
    }
  }
</style>
