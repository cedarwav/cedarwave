---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Thank you" description="Your message has been sent to Cedar Wave Advisory.">
  <section class="section wrap thanks">
    <p class="eyebrow">Message sent</p>
    <h1>Thanks — I'll be in touch soon.</h1>
    <p>I read every message personally and usually reply within a couple of business days.</p>
    <a href="/" class="btn btn--outline">Back to home</a>
  </section>
</Layout>

<style>
  .thanks {
    text-align: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .thanks p {
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
