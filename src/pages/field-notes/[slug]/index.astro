---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="section wrap post">
    <p class="post__date">
      {post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
    </p>
    <h1>{post.data.title}</h1>
    <div class="post__body">
      <Content />
    </div>
    <a href="/field-notes/" class="btn btn--outline post__back">&larr; All Field Notes</a>
  </article>
</Layout>

<style>
  .post {
    max-width: 700px;
  }

  .post__date {
    color: var(--cedar);
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }

  .post__body :global(h2) {
    margin-top: 1.75em;
  }

  .post__body :global(p) {
    font-size: 1.02rem;
  }

  .post__body :global(a) {
    color: var(--forest);
    text-decoration: underline;
  }

  .post__back {
    margin-top: 2rem;
  }
</style>
