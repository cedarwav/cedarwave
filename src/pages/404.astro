---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="This page doesn't exist.">
  <section class="section wrap notfound">
    <p class="eyebrow">404</p>
    <h1>This page wandered off.</h1>
    <p>The page you're looking for doesn't exist, or it's moved.</p>
    <a href="/" class="btn btn--outline">Back to home</a>
  </section>
</Layout>

<style>
  .notfound {
    text-align: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .notfound p {
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
